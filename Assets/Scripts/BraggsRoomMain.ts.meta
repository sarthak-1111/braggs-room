  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">BraggsRoomMain – runs the Bragg simulation and draws each frame</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 crystal {"hint":"Crystal (BraggsRoomCrystalController): the pinch-drag target"}'
    - '// @input AssignableType_2 crystalCell {"hint":"CrystalVisual (CrystalCellMesh): SC / FCC / mystery cell"}'
    - '// @input AssignableType_3 spotPool {"hint":"SpotPool (BraggsRoomSpotPool): lit spots, ghosts, rays, chimes"}'
    - '// @input AssignableType_4 wallLabels {"hint":"WallLabels (BraggsRoomWallLabelsUI): spot / ghost / 2θ labels, off-wall hint"}'
    - '// @input AssignableType_5 evidenceBoard {"hint":"EvidenceBoard (BraggsRoomEvidenceBoardUI)"}'
    - '// @input AssignableType_6 controlConsole {"hint":"Console (BraggsRoomConsoleUI): wavelength slider, reset, SC/FCC"}'
    - '// @input AssignableType_7 goniometerLabels {"hint":"GoniometerLabels (BraggsRoomGoniometerUI): φ / χ readouts and the sample tag"}'
    - '// @input AssignableType_8 predictor {"hint":"PredictorPanel (BraggsRoomPredictorUI): the (hkl) steppers above the console"}'
    - '// @input AssignableType_9 predictionRing {"hint":"PredictionRing (BraggsRoomPredictionRing): the predicted 2θ ring on the wall"}'
    - '// @input AssignableType_10 guideArrow {"hint":"GuideArrow (BraggsRoomGuideArrow): which way to drag"}'
    - '// @input AssignableType_11 edgeChevron {"hint":"EdgeChevron (BraggsRoomEdgeChevron): points at a lit spot outside the view"}'
    - "// @input AssignableType_12 missionAudio {\"hint\":\"MissionAudio (BraggsRoomMissionAudio): flourish and 'not yet' tone\"}"
    - '// @input AssignableType_13 beam {"hint":"Beam (BeamMesh): plays the intro reveal at Lens start"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float dragGainDegPerCm = 3 {"hint":"Degrees of crystal rotation per cm of hand (or mouse) drag. Left/right turns φ, up/down tilts χ.", "widget":"slider", "min":0.5, "max":10, "step":0.1}'
    - '// @input float chimeMinIntervalSec = 0.25 {"hint":"Shortest time between two spot chimes, seconds (several spots often light together at Mo Kα)", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - '// @input float introBeamSec = 2 {"hint":"Intro: seconds for the bright head to travel from the X-ray tube to the beam stop at Lens start", "widget":"slider", "min":0.5, "max":5, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
